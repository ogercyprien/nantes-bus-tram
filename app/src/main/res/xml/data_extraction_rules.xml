<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-transfer rules for Android 12+ (android:dataExtractionRules). Same intent as
  backup_rules.xml: back up / transfer user data (favorites, recent searches, preferences), let the
  HTTP caches (cacheDir) be dropped and re-fetched. Applies to both cloud backup and device-to-device
  transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
