<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose supplies the actual Material 3 ColorScheme at runtime
         (with dynamic color on Android 12+); this XML theme only needs to exist so the
         Activity/Manifest resolve a window theme before Compose content is set. -->
    <style name="Theme.BusEtTramNantes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
